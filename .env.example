# Solo necesario si quieres correr el set público en tu computador con tu propio modelo.
# El servidor del taller NO usa este archivo: allá el modelo es fijo para todos.
LLM_PROVIDER=openai_compatible     # "mock" = sin modelo (solo para ver que todo corre)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=none
LLM_MODEL=qwen2.5:7b-instruct
# Opcionales: LLM_MAX_TOKENS=1200  LLM_TIMEOUT_S=90  LLM_EXTRA_BODY={"reasoning_effort":"low"}
