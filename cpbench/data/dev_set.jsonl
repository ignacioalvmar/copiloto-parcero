{"id": "dev-01", "category": "single_step", "message": "Ponme el aire en 22, por favor.", "context_init": {}, "expect": {"actions_any_of": [[{"name": "set_climate_temperature", "kwargs": {"zone": "DRIVER", "temperature": 22}}], [{"name": "set_climate_temperature", "kwargs": {"zone": "ALL_ZONES", "temperature": 22}}]], "expected_state": {"climate_temperature_driver": 22}}, "notes": "Zona no dicha: conductor o todas las zonas valen."}
{"id": "dev-02", "category": "single_step", "message": "Prende la luz de lectura de mi copiloto.", "context_init": {"seats_occupancy": {"DRIVER": true, "PASSENGER": true, "DRIVER_REAR": false, "PASSENGER_REAR": false}}, "expect": {"actions": [{"name": "set_reading_light", "kwargs": {"seat": "PASSENGER", "on": true}}]}}
{"id": "dev-03", "category": "single_step", "message": "Llévame a la droguería más cercana.", "context_init": {}, "expect": {"actions": [{"name": "set_navigation_destination", "kwargs": {"destination_name": {"contains": ["drogue", "farmac"]}}}]}}
{"id": "dev-04", "category": "single_step", "message": "Bájale al volumen, déjalo en 2.", "context_init": {"music_playing": true, "music_volume": 6}, "expect": {"actions": [{"name": "set_music_volume", "kwargs": {"level": 2}}]}}
{"id": "dev-05", "category": "single_step", "message": "Sube la ventana del copiloto del todo.", "context_init": {"window_passenger_position": 70}, "expect": {"actions": [{"name": "open_close_window", "kwargs": {"window": "PASSENGER", "percentage": 0}}], "expected_state": {"window_passenger_position": 0}}}
{"id": "dev-06", "category": "multi_step", "message": "Está empañado el parabrisas, hágale.", "context_init": {"fan_speed": 0, "air_conditioning": false, "fan_airflow_direction": "FEET", "window_front_defrost": false}, "expect": {"actions": [{"name": "set_window_defrost", "kwargs": {"window": {"in": ["FRONT", "ALL"]}, "on": true}}], "expected_state": {"window_front_defrost": true}, "policies": ["AUT-POL:010"]}, "notes": "AUT-POL:010: ventilador >= 2, aire al parabrisas y A/C encendido en el mismo turno."}
{"id": "dev-07", "category": "multi_step", "message": "Prende las exploradoras que hay mucha neblina.", "context_init": {"head_lights_low_beams": false, "fog_lights": false, "weather": "neblina densa", "time_of_day": "noche"}, "expect": {"actions": [{"name": "set_head_lights_low_beams", "kwargs": {"on": true}, "index": 0}, {"name": "set_fog_lights", "kwargs": {"on": true}, "index": 1, "dependent_on_action_index": 0}], "expected_state": {"fog_lights": true, "head_lights_low_beams": true}, "policies": ["AUT-POL:013"]}, "notes": "Exploradoras = antiniebla. Primero las bajas, luego las antiniebla."}
{"id": "dev-08", "category": "multi_step", "message": "Yo estoy asado y a mi copiloto le da frío.", "context_init": {"climate_temperature_driver": 22, "climate_temperature_passenger": 22, "seats_occupancy": {"DRIVER": true, "PASSENGER": true, "DRIVER_REAR": false, "PASSENGER_REAR": false}}, "expect": {"actions": [{"name": "set_climate_temperature", "kwargs": {"zone": "DRIVER", "temperature": {"lte": 21}}}, {"name": "set_climate_temperature", "kwargs": {"zone": "PASSENGER", "temperature": {"gte": 23}}}], "expected_state": {"climate_temperature_driver": {"lte": 21}, "climate_temperature_passenger": {"gte": 23}}}}
{"id": "dev-09", "category": "multi_step", "message": "Vamos a entrar al túnel: prende las luces y cierra las ventanas.", "context_init": {"window_driver_position": 40, "window_passenger_position": 40, "head_lights_low_beams": false}, "expect": {"actions": [{"name": "set_head_lights_low_beams", "kwargs": {"on": true}}], "expected_state": {"head_lights_low_beams": true, "window_driver_position": 0, "window_passenger_position": 0}}}
{"id": "dev-10", "category": "multi_step", "message": "Pon música y déjala en volumen 3.", "context_init": {"music_playing": false, "music_volume": 6}, "expect": {"actions": [{"name": "play_music", "kwargs": {}}, {"name": "set_music_volume", "kwargs": {"level": 3}}], "expected_state": {"music_playing": true, "music_volume": 3}}}
{"id": "dev-11", "category": "ambiguous", "message": "Prende una luz.", "followup": "La de lectura, la mía.", "context_init": {}, "expect": {"must_ask": true, "actions": [{"name": "set_reading_light", "kwargs": {"seat": "DRIVER", "on": true}}]}}
{"id": "dev-12", "category": "ambiguous", "message": "Súbele.", "followup": "Al volumen.", "context_init": {"music_playing": true, "music_volume": 3}, "expect": {"must_ask": true, "actions": [{"name": "set_music_volume", "kwargs": {"level": {"gte": 4}}}], "expected_state": {"music_volume": {"gte": 4}}}}
